generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id             String    @id @default(cuid())
  clerkUserId    String?   @unique
  email          String?   @unique
  name           String
  role           UserRole  @default(student)
  credits        Int       @default(0)
  unlimitedCredits Boolean @default(false)
  plan           String    @default("free")
  paymentStatus  String    @default("free")
  gradeLevel     String    @default("S2") // e.g. "P6", "S1"..."S6"
  locale         String    @default("zh-HK")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  submissions       Submission[]
  weaknessProfiles  WeaknessProfile[]
  revisionSessions  RevisionSession[]
  feedbackEvents    FeedbackEvent[]
  aiModelPassages   AiModelPassage[]
  notebookEntries   NotebookEntry[]
  teacherReviews    TeacherReview[]
  topicAnalyses     TopicAnalysis[]
  practiceDrills    PracticeDrill[]
  assignmentsCreated Assignment[]

  @@map("AppUser")
}

enum UserRole {
  student
  teacher
  admin
}

model CreditTransaction {
  id                    String   @id @default(cuid())
  clerkUserId            String
  amount                Int
  reason                String
  createdByClerkUserId  String?
  createdAt             DateTime @default(now())

  @@index([clerkUserId])
  @@index([createdAt])
}

model Class {
  id                  String   @id @default(cuid())
  name                String
  teacherClerkUserId  String
  createdAt           DateTime @default(now())

  studentClasses  StudentClass[]
  assignments     Assignment[]

  @@index([teacherClerkUserId])
}

// A writing task a teacher sets for one class. Students submit against it with
// their own credits; the AI 參考範文 stays locked until the teacher releases it.
model Assignment {
  id                   String    @id @default(cuid())
  classId              String
  createdByUserId      String
  taskPrompt           String    @db.Text
  genre                String?
  instructions         String?   @db.Text
  dueAt                DateTime?
  modelPassageReleased Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   AppUser      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([classId, createdAt])
}

model StudentClass {
  id                  String @id @default(cuid())
  studentClerkUserId  String
  classId             String

  class  Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentClerkUserId, classId])
  @@index([studentClerkUserId])
  @@index([classId])
}

enum SubmissionType {
  writing
  reading
  revision
}

enum SubmissionSource {
  typed
  photo
  scan
}

enum SubmissionStatus {
  uploaded
  verified
  analyzed
  failed
}

model Submission {
  id                    String             @id @default(cuid())
  userId                String
  type                  SubmissionType     @default(writing)
  source                SubmissionSource   @default(typed)
  rawText               String             @db.Text
  verifiedText          String             @db.Text
  imageUrl              String?
  ocrConfidenceOverall  Float?
  ocrCharConfidences    Json?
  status                SubmissionStatus   @default(uploaded)
  taskId                String?
  taskPrompt            String?            @db.Text // free-text 題目 typed by the student
  genre                 String?            // 文體 chosen by the student; null = let the model decide
  timedMinutes          Int?               // 限時模擬: the time limit chosen, if the essay was written under a timer
  writingSeconds        Int?               // time actually used under the timer
  assignmentId          String?            // set when written for a teacher's Assignment
  createdAt             DateTime           @default(now())

  user             AppUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  task             WritingTask?         @relation(fields: [taskId], references: [id])
  assignment       Assignment?          @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  analyses         Analysis[]
  errors           ErrorRecord[]
  revisionOrigin   RevisionSession[]    @relation("OriginalSubmission")
  aiModelPassage   AiModelPassage?
  notebookEntries  NotebookEntry[]
  teacherReviews   TeacherReview[]

  @@index([userId, createdAt])
  @@index([assignmentId])
}

model Analysis {
  id                 String    @id @default(cuid())
  submissionId       String
  rubricId           String?
  scores             Json      // { content: number, structure: number, ... }
  overallScore       Float
  modelName          String
  modelVersion       String?
  promptVersion      String
  coachFeedbackText  String    @db.Text
  revisionPriorities Json      // string[]
  strengths          Json      // string[]
  themeElevation     Json?     // 立意昇華 suggestions, generated on demand (src/lib/themeElevation.ts)
  createdAt          DateTime  @default(now())

  submission      Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rubric          Rubric?         @relation(fields: [rubricId], references: [id])
  errors          ErrorRecord[]
  teacherReviews  TeacherReview[]
}

model ErrorRecord {
  id               String   @id @default(cuid())
  submissionId     String
  analysisId       String
  category         String   // 字詞 / 語法 / 標點 / 結構 / 內容 / 表達
  subcategory      String
  evidenceSpan     String   @db.Text
  charOffsetStart  Int
  charOffsetEnd    Int
  suggestion       String   @db.Text
  exampleFix       String?  @db.Text
  severity         Int      // 1..3
  ocrSuspect       Boolean  @default(false)
  studentReaction  String?  // latest "helpful" | "wrong" | "confusing"; "wrong" keeps it out of weakness profiles
  confidence       Float    @default(0.8)
  createdAt        DateTime @default(now())

  submission  Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  analysis    Analysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([category, subcategory])
}

// A teacher's own marking of an analysed essay. Shown to the student and
// exportable as calibration data (scripts/export-teacher-reviews.ts).
model TeacherReview {
  id              String   @id @default(cuid())
  submissionId    String
  analysisId      String
  reviewerUserId  String
  scores          Json     // { content, expression, structure, punctuation }
  typoCount       Int?
  dseLevel        String
  comment         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submission  Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  analysis    Analysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  reviewer    AppUser     @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@unique([analysisId, reviewerUserId])
  @@index([submissionId])
}

// 審題助手 result for a topic a student is about to write on. Cached per
// (user, topic, genre, prompt version) and used for the daily limit.
model TopicAnalysis {
  id            String   @id @default(cuid())
  userId        String
  taskPrompt    String   @db.Text
  genre         String?
  gradeLevel    String
  result        Json
  modelName     String
  promptVersion String
  createdAt     DateTime @default(now())

  user  AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 150-字 micro-drill generated from a weakness (category, subcategory).
// Practice only: it never changes weakness profiles.
model PracticeDrill {
  id           String    @id @default(cuid())
  userId       String
  category     String
  subcategory  String
  task         Json
  response     String?   @db.Text
  feedback     Json?
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  user  AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum WeaknessStatus {
  watching
  confirmed
  improving
  resolved
}

model WeaknessProfile {
  id                    String          @id @default(cuid())
  userId                String
  category              String
  subcategory           String
  evidenceCount         Int             @default(0)
  evidenceSubmissionIds String[]
  severityEwma          Float           @default(0)
  firstSeenAt           DateTime        @default(now())
  lastSeenAt            DateTime        @default(now())
  status                WeaknessStatus  @default(watching)
  recentCounts          Json            // rolling window: [{submissionId, count, date}]

  user  AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, subcategory])
  @@index([userId, status])
}

model RevisionSession {
  id                     String   @id @default(cuid())
  userId                 String
  originalSubmissionId   String
  revisedText            String   @db.Text
  targetedErrorIds       String[]
  improvementDelta       Json?
  regrade                Json?    // re-grade of revisedText (src/lib/regradeCompare.ts); kept off Submission so it never feeds weakness tracking
  createdAt              DateTime @default(now())

  user                AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalSubmission  Submission  @relation("OriginalSubmission", fields: [originalSubmissionId], references: [id], onDelete: Cascade)
}

model AiModelPassage {
  id            String   @id @default(cuid())
  userId        String
  submissionId  String   @unique
  generatedText String   @db.Text
  highlights    Json
  modelName     String
  promptVersion String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            AppUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission      Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  notebookEntries NotebookEntry[]

  @@index([userId, updatedAt])
}

enum NotebookEntryType {
  manual
  phrase
  lesson
}

model NotebookEntry {
  id               String            @id @default(cuid())
  userId           String
  submissionId     String?
  sourcePassageId  String?
  entryType        NotebookEntryType
  title            String?
  content          String            @db.Text
  focusTag         String?
  tags             String[]
  sourceBeforeText String?           @db.Text
  sourceAfterText  String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user          AppUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission    Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  sourcePassage AiModelPassage? @relation(fields: [sourcePassageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, focusTag])
  @@index([submissionId])
}

model Rubric {
  id           String   @id @default(cuid())
  gradeLevel   String
  type         String   // writing | reading
  genre        String?
  rubricJson   Json
  createdAt    DateTime @default(now())

  analyses  Analysis[]

  @@unique([gradeLevel, type, genre])
}

model WritingTask {
  id              String   @id @default(cuid())
  gradeLevel      String
  genre           String
  promptText      String   @db.Text
  guidance        String?  @db.Text
  suggestedLength Int?
  createdAt       DateTime @default(now())

  submissions  Submission[]
}

model FeedbackEvent {
  id          String   @id @default(cuid())
  userId      String
  targetType  String   // "error" | "suggestion"
  targetId    String
  reaction    String   // "helpful" | "wrong" | "confusing"
  note        String?
  createdAt   DateTime @default(now())

  user  AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}
